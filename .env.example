# Mentor Platform Configuration
# Copy this file to .env and update values as needed

# Application
APP_NAME=Mentor
APP_ENV=development
DEBUG=true
SECRET_KEY=your-secret-key-change-in-production
API_V1_PREFIX=/api/v1

# Database
DATABASE_URL=postgresql+asyncpg://mentor:mentor@localhost:5432/mentor
DATABASE_POOL_SIZE=20
DATABASE_MAX_OVERFLOW=10

# Redis
REDIS_URL=redis://localhost:6379/0

# Authentication
JWT_SECRET_KEY=your-jwt-secret-key-change-in-production
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7

# OAuth (optional)
OAUTH_ENABLED=false
OAUTH_PROVIDER=
OAUTH_CLIENT_ID=
OAUTH_CLIENT_SECRET=
OAUTH_REDIRECT_URI=

# LLM Configuration
LLM_PROVIDER=ollama
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_DEFAULT_MODEL=llama3.1:8b

# Optional: Cloud LLM providers
TOGETHER_API_KEY=
OPENROUTER_API_KEY=
OPENAI_API_KEY=
ANTHROPIC_API_KEY=

# Embeddings
EMBEDDING_MODEL=all-MiniLM-L6-v2
EMBEDDING_DIMENSION=384

# File Storage
UPLOAD_DIR=./uploads
MAX_UPLOAD_SIZE_MB=50

# Gaming Detection Thresholds
GAMING_MIN_RESPONSE_TIME_MS=3000
GAMING_MIN_COHERENCE=0.4
GAMING_MAX_COMPETENCE_JUMP=0.4
GAMING_AI_DETECTION_THRESHOLD=0.7

# Research
RESEARCH_MODE=false
ENABLE_DATA_EXPORT=false

# Logging
LOG_LEVEL=INFO
LOG_FORMAT=json

# CORS (comma-separated origins)
CORS_ORIGINS=http://localhost:3000,http://localhost:5173

# Frontend URL (for email links, etc.)
FRONTEND_URL=http://localhost:5173

# Voice Layer Configuration
VOICE_ENABLED=true

# Speech-to-Text (STT)
STT_MODEL=medium          # tiny, base, small, medium, large-v3
STT_DEVICE=cuda           # cuda or cpu
STT_COMPUTE_TYPE=float16  # float16, int8, float32
STT_LANGUAGE=en

# Voice Activity Detection (VAD)
VAD_THRESHOLD=0.5
VAD_MIN_SPEECH_DURATION_MS=250
VAD_MIN_SILENCE_DURATION_MS=700
VAD_MAX_SPEECH_DURATION_S=30

# Text-to-Speech (TTS)
TTS_ENGINE=hybrid         # piper, xtts, hybrid
PIPER_MODEL=en_US-lessac-medium
XTTS_MODEL=tts_models/multilingual/multi-dataset/xtts_v2
VOICE_SAMPLE_PATH=        # Path to voice sample for cloning (optional)

# Voice Gaming Detection
VOICE_GAMING_MIN_LATENCY_MS=500
VOICE_GAMING_MAX_LATENCY_MS=10000
VOICE_GAMING_MIN_WPM=100
VOICE_GAMING_MAX_WPM=180
